+# which ResNet layers train
+def set_trainable(base_model, train_block):
+    """train_block=True: only layers in TRAINABLE_BLOCK train (minus their BatchNorm layers if FREEZE_BN).
+    train_block=False: the whole ResNet is frozen (head-only warm-up).
+    A frozen BatchNorm layer runs in inference mode: it uses ImageNet's stored statistics and doesn't update them."""
+    for layer in base_model.layers:
+        frozen_bn = FREEZE_BN and isinstance(layer, BatchNormalization)
+        layer.trainable = train_block and (TRAINABLE_BLOCK in layer.name) and not frozen_bn
+
+def make_optimizer(learning_rate, n_steps, schedule):
+    """Adam with a constant learning rate, or one that decays along a cosine curve to ~0 over n_steps."""
+    if schedule == "cosine":
+        learning_rate = tf.keras.optimizers.schedules.CosineDecay(learning_rate, decay_steps=n_steps)
+    return tf.keras.optimizers.Adam(learning_rate=learning_rate)
+
